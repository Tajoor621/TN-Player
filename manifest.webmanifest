{
  "id": "./",
  "name": "TN-Player",
  "short_name": "TN-Player",
  "description": "Play local video and audio in your browser. No account or upload required.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./player.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#081d21",
  "theme_color": "#081d21",
  "categories": ["entertainment", "music", "utilities"],
  "icons": [
    {"src": "./assets/tn-player-brand.png", "sizes": "768x768", "type": "image/png", "purpose": "any"},
    {"src": "./assets/tn-player-icon.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "./assets/tn-player-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {
      "name": "Open web player",
      "short_name": "Play media",
      "url": "./player.html",
      "icons": [{"src": "./assets/tn-player-icon.png", "sizes": "192x192", "type": "image/png"}]
    },
    {
      "name": "Get the Android app",
      "short_name": "Android app",
      "url": "./#title",
      "icons": [{"src": "./assets/tn-player-icon.png", "sizes": "192x192", "type": "image/png"}]
    }
  ]
}
